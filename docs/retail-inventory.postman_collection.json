        {
          "name": "Export Sales CSV",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/sales/export",
              "host": ["{{baseUrl}}"],
