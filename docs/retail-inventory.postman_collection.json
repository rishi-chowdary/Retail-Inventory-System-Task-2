        {
          "name": "Net Profit Analysis (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/profit",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "profit"]
            }
          }
        }
      ]
    }
  ]
}
