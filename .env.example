# ==============================================================================
# RetailPulse Monorepo Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Option A: Local Replica Set (default):
MONGODB_URI=mongodb://127.0.0.1:27017/retail_inventory?replicaSet=rs0
# Option B: MongoDB Atlas Cloud (Replica set built-in):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/retail_inventory?retryWrites=true&w=majority

# JWT Authentication Security:
JWT_SECRET=super_secret_jwt_key_development_change_in_production
JWT_EXPIRES_IN=24h

# Frontend Client URL (for CORS allowance):
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
